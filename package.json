{
  "name": "quimiport",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "scripts": {
    "dev": "tsx src/interfaces/http/server.ts",
    "test": "vitest run --exclude \"**/*.integration.test.ts\"",
    "test:watch": "vitest --exclude \"**/*.integration.test.ts\"",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate --config prisma7.config.ts",
    "db:migrate": "prisma migrate deploy --config prisma7.config.ts",
    "start": "tsx src/interfaces/http/server.ts",
    "build": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jhCarneiro/quimiport.git"
  },
